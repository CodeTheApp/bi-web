# ---------- Site ----------
NEXT_PUBLIC_SITE_URL=https://www.brasiliailuminacao.com.br

# ---------- Supabase (back-end e banco) ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Só no servidor: usada pelo formulário de contato e pelo webhook de e-mail
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Amazon S3 + CloudFront (fotos e anexos) ----------
# (o Amplify não aceita variáveis que começam com AWS_, por isso S3_REGION)
S3_REGION=sa-east-1
S3_BUCKET=brasilia-iluminacao-media
# Credenciais de um usuário IAM com s3:PutObject/DeleteObject só nesse bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# URL pública dos arquivos (domínio do CloudFront)
NEXT_PUBLIC_MEDIA_BASE_URL=https://dxxxxxxxx.cloudfront.net

# ---------- Resend (e-mail) ----------
RESEND_API_KEY=
EMAIL_FROM="Brasília Iluminação <contato@brasiliailuminacao.com.br>"
# Para onde vão os avisos de novo contato
EMAIL_TEAM_TO=contato@brasiliailuminacao.com.br
# Segredo do webhook do Resend (whsec_...) — e-mails recebidos e status de entrega
RESEND_WEBHOOK_SECRET=
# Domínio de recebimento do Resend (ex.: respostas.brasiliailuminacao.com.br). Com ele, a resposta
# do cliente volta direto para a conversa certa no painel (Reply-To: t-<id>@dominio).
EMAIL_INBOUND_DOMAIN=

# ---------- Formulário ----------
# Cloudflare Turnstile (opcional; sem as chaves o formulário usa só honeypot + limite)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---------- Painel ----------
# Sem Supabase o painel abre em modo demonstração (dados de exemplo em memória) fora de produção.
# ADMIN_DEMO=1 libera a demonstração também em produção (ex.: um ambiente de apresentação). Nunca no site real.
ADMIN_DEMO=
